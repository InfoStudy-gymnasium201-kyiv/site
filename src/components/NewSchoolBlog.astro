---
// NewsBlog.astro
---

<!-- MAIN CONTENT CONTAINER -->
<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- LATEST NEWS SECTION -->
    <section id="latest-news">
        <div class="text-center mb-12">
            <!-- Верхній бейдж -->
            <span
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100 shadow-sm mb-3"
            >
                <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
                Освітнє життя
            </span>

            <!-- Основний заголовок -->
            <h2 class="font-oswald text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
                Останні новини
            </h2>

            <!-- Опис -->
            <p class="text-slate-600 text-sm sm:text-base mt-3 max-w-xl mx-auto font-normal">
                Будьте в курсі всіх важливих подій, досягнень та оголошень нашої гімназії
            </p>

            <!-- Декоративна лінія -->
            <div class="mt-4 flex items-center justify-center gap-2">
                <div class="h-1 w-12 bg-indigo-600 rounded-full"></div>
                <div class="h-1 w-2 bg-indigo-400 rounded-full"></div>
                <div class="h-1 w-1 bg-indigo-200 rounded-full"></div>
            </div>
        </div>

        <!-- Dynamic News Grid Container -->
        <div class="news-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="blog_area">
            <!-- Dynamic items loaded via Client Script -->
        </div>
    </section>
</main>

<!-- NEWS DETAIL MODAL -->
<div
    id="news-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
>
    <div
        class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-slate-100 transform scale-95 transition-transform duration-300 relative"
    >
        <!-- Close Button -->
        <button
            id="close-modal-btn"
            class="absolute top-4 right-4 z-10 w-9 h-9 bg-slate-900/40 hover:bg-slate-900/70 text-white rounded-full flex items-center justify-center transition-all"
        >
            <i class="fa-solid fa-xmark"></i>
        </button>

        <!-- Modal Image -->
        <div class="h-64 sm:h-72 relative">
            <img id="modal-img" src="" alt="Деталі новини" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-6 right-6 text-white">
                <span
                    id="modal-date"
                    class="font-oswald text-xs sm:text-sm text-amber-300 font-medium flex items-center gap-2 mb-1"
                >
                    <i class="fa-regular fa-calendar-alt"></i> <span></span>
                </span>
                <h3 id="modal-title" class="font-oswald text-xl sm:text-2xl font-bold leading-snug drop-shadow-sm"></h3>
            </div>
        </div>

        <!-- Modal Body Text -->
        <div class="p-6 sm:p-8 space-y-4">
            <p id="modal-text" class="text-slate-600 leading-relaxed text-sm sm:text-base whitespace-pre-line"></p>
            <div class="pt-4 border-t border-slate-100 flex justify-end">
                <button
                    id="close-modal-bottom-btn"
                    class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-xl transition-all"
                >
                    Закрити
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function ensureLength(str: string, desiredLength = 188) {
        if (str.length > desiredLength) {
            return str.slice(0, desiredLength) + "...";
        } else {
            return str + "...";
        }
    }

    // Modal Control Functions
    function openNewsModal(title: string, date: string, text: string, imgSrc: string) {
        const modal = document.getElementById('news-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalDateSpan = document.getElementById('modal-date')?.querySelector('span');
        const modalText = document.getElementById('modal-text');
        const modalImg = document.getElementById('modal-img') as HTMLImageElement;

        if (modal && modalTitle && modalDateSpan && modalText && modalImg) {
            modalTitle.textContent = title;
            modalDateSpan.textContent = date;
            modalText.textContent = text;
            modalImg.src = imgSrc;

            modal.classList.remove('opacity-0', 'pointer-events-none');
            const dialog = modal.querySelector('div');
            dialog?.classList.remove('scale-95');
            dialog?.classList.add('scale-100');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeNewsModal() {
        const modal = document.getElementById('news-modal');
        if (modal) {
            modal.classList.add('opacity-0', 'pointer-events-none');
            const dialog = modal.querySelector('div');
            dialog?.classList.remove('scale-100');
            dialog?.classList.add('scale-95');
            document.body.style.overflow = 'auto';
        }
    }

    // Fetch and Load Blog Posts
    async function loadBlogPosts() {
        const urlParams = new URLSearchParams(window.location.search);
        let page_id = urlParams.get("page");

        if (!page_id) {
            page_id = "1";
        }
        const pageNum = parseInt(page_id, 10);

        try {
            const response = await fetch('https://raw.githubusercontent.com/gymnasium201-kyiv/news-storage/refs/heads/main/storage_info.json');
            const json = await response.json();
            const blog_area = document.getElementById("blog_area");

            if (!blog_area) return;

            const fetchPostPromises = [];
            const posts = json['posts'];
            const postsPerPage = 9;
            const startIndex = posts.length - 1 - ((pageNum - 1) * postsPerPage);
            const endIndex = posts.length - 1 - ((pageNum - 1) * postsPerPage) - postsPerPage;

            for (let i = startIndex; i >= 0 && i > endIndex; i--) {
                const postId = posts[i];
                fetchPostPromises.push(
                    fetch(`https://raw.githubusercontent.com/gymnasium201-kyiv/news-storage/refs/heads/main/news-storage/${postId}/post_info.json`)
                        .then(res => res.json())
                        .then(post_data => {
                            let rawText = post_data['post_text'] ? post_data['post_text'].join('\n\n') : '';
                            let cleanDesc = rawText.replace(/<[^>]*>/g, '');
                            let shortDesc = ensureLength(cleanDesc, 160);
                            let mainImgUrl = `https://raw.githubusercontent.com/gymnasium201-kyiv/news-storage/refs/heads/main/news-storage/${postId}/${post_data['main_image']}`;

                            return {
                                id: postId,
                                title: post_data['post_title'],
                                date: post_data['post_date'],
                                fullText: cleanDesc,
                                shortDesc: shortDesc,
                                image: mainImgUrl
                            };
                        })
                );
            }

            const postsData = await Promise.all(fetchPostPromises);

            // Generate HTML using Tailwind CSS structure from 201 (1).html
            blog_area.innerHTML = postsData.map(post => `
                <article class="news-card bg-white rounded-2xl overflow-hidden shadow-md border border-slate-100 flex flex-col justify-between hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group" id="${post.id}">
                    <div>
                        <div class="relative overflow-hidden h-48 sm:h-52">
                            <img src="${post.image}"
                                 alt="${post.title}"
                                 class="news-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                 onerror="this.src='https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=800&q=80'">
                        </div>
                        <div class="news-content p-5 sm:p-6">
                            <div class="news-date flex items-center gap-2 text-slate-500 font-oswald text-xs sm:text-sm font-medium mb-2">
                                <i class="fa-regular fa-calendar-alt text-[#4b6496]"></i>
                                <span>${post.date}</span>
                            </div>
                            <h3 class="news-title font-oswald text-lg sm:text-xl font-bold text-slate-800 leading-snug mb-3 group-hover:text-[#4b6496] transition-colors">
                                ${post.title}
                            </h3>
                            <p class="text-slate-600 text-xs sm:text-sm line-clamp-3 mb-4 leading-relaxed">
                                ${post.shortDesc}
                            </p>
                        </div>
                    </div>
                    <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-0">
                        <button class="open-modal-btn w-full btn-gradient-shadow text-white text-xs sm:text-sm font-medium py-2.5 px-4 rounded-xl flex items-center justify-center gap-2">
                            <span>Читати повністю</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                    </div>
                </article>
            `).join('');

            // Attach listeners to "Читати повністю" buttons to open the modal viewer
            postsData.forEach(post => {
                const card = document.getElementById(post.id);
                const btn = card?.querySelector('.open-modal-btn');
                btn?.addEventListener('click', (e) => {
                    e.stopPropagation();
                    openNewsModal(post.title, post.date, post.fullText, post.image);
                });

                // Optional: navigate to individual post page on full card click
                card?.addEventListener('click', () => {
                    openNewsModal(post.title, post.date, post.fullText, post.image);
                    // Alternatively, redirect: window.location.href = `/post/?post_id=${post.id}`;
                });
            });

        } catch (error) {
            console.error("Помилка завантаження новин:", error);
        }
    }

    // Initialize Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
        loadBlogPosts();

        const closeBtn = document.getElementById('close-modal-btn');
        const closeBottomBtn = document.getElementById('close-modal-bottom-btn');
        const modal = document.getElementById('news-modal');

        closeBtn?.addEventListener('click', closeNewsModal);
        closeBottomBtn?.addEventListener('click', closeNewsModal);

        modal?.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeNewsModal();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeNewsModal();
            }
        });
    });
</script>

<style is:global>
    /* Gradient shadow utility matching 201 (1).html design */
    .btn-gradient-shadow {
        background-image: linear-gradient(135deg, #6366f1 0%, #4b6496 100%);
        box-shadow: 0 4px 14px rgba(75, 100, 150, 0.35);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-gradient-shadow:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(75, 100, 150, 0.45);
    }
</style>
