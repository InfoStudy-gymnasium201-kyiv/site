---
interface Props {
  badge?: string;
  title?: string;
  description?: string;
  keyQuestionLabel?: string;
  keyQuestion?: string;
}
---

<section class="bg-gradient-to-b from-brand-900 via-brand-800 to-emerald-900 text-white py-12 md:py-16 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#86efac_1px,transparent_1px)] [background-size:16px_16px]"></div>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center md:text-left">
    {badge && (
      <div class="inline-flex items-center space-x-2 bg-brand-500/20 backdrop-blur-md border border-brand-400/30 px-3 py-1 rounded-full text-brand-200 text-xs font-medium mb-4">
        <span>{badge}</span>
      </div>
    )}
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading tracking-tight text-white mb-4">
      {title}
    </h1>
    <p class="text-brand-100 text-base sm:text-lg max-w-3xl leading-relaxed mb-6">
      {description}
    </p>
    
    {keyQuestion && (
      <div class="bg-white/10 backdrop-blur-sm border border-white/15 rounded-2xl p-4 sm:p-5 text-brand-50 text-sm flex items-start space-x-3 max-w-2xl">
        <svg class="w-6 h-6 text-brand-300 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <strong class="text-white font-semibold">{keyQuestionLabel}</strong>
          <p class="mt-0.5 text-brand-100">{keyQuestion}</p>
        </div>
      </div>
    )}
  </div>
</section>
