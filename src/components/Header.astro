---
// src/components/Header.astro

// Динамічний список посилань навігації
const navLinks = [
  { href: "#important-news", label: "Новини" },
  { href: "#contacts", label: "Інформація про заклад" },
  { href: "#hero", label: "Історія гімназії" },
  { href: "#important-news", label: "Прозорість та інформаційна відкритість закладу" },
  { href: "#latest-news", label: "Заклад - частина європейського освітнього простору" },
  { href: "#latest-news", label: "Освітній процес" },
];

const socialLinks = [
  { href: "https://facebook.com", icon: "fa-brands fa-facebook-f", label: "Facebook" },
  { href: "https://t.me", icon: "fa-brands fa-telegram", label: "Telegram" },
  { href: "https://instagram.com", icon: "fa-brands fa-instagram", label: "Instagram" },
  { href: "https://youtube.com", icon: "fa-brands fa-youtube", label: "YouTube" },
];
---

<header class="relative bg-gradient-to-br from-[#394e77] via-[#4b6496] to-[#2c3e50] text-white overflow-hidden shadow-lg border-b border-indigo-900/20">
    
    <!-- Animated Background Decorative Floating Icons -->
    <div class="animated-background absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="pop-item item-1 text-4xl text-white/30"><i class="fa-solid fa-graduation-cap"></i></div>
        <div class="pop-item item-2 text-3xl text-white/30"><i class="fa-solid fa-book-open"></i></div>
        <div class="pop-item item-3 text-4xl text-white/30"><i class="fa-solid fa-atom"></i></div>
        <div class="pop-item item-4 text-3xl text-white/30"><i class="fa-solid fa-award"></i></div>
        <div class="pop-item item-5 text-4xl text-white/30"><i class="fa-solid fa-pen-nib"></i></div>
    </div>

    <!-- TOP NAVIGATION BAR -->
    <nav class="relative z-20 bg-slate-900/40 backdrop-blur-md border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-auto min-h-[3.5rem] py-2 text-sm font-medium">
            
            <!-- Desktop Navigation Menu Links -->
            <div class="hidden xl:flex items-center space-x-3 2xl:space-x-5 py-1">
                {navLinks.map((link, index) => (
                    <a 
                        href={link.href} 
                        class={`transition-colors px-2 py-1 rounded-md text-xs 2xl:text-sm whitespace-nowrap ${index === 0 ? 'text-white hover:text-amber-300 font-semibold' : 'text-slate-200 hover:text-amber-300'}`}
                    >
                        {link.label}
                    </a>
                ))}
            </div>

            <!-- Mobile Menu Button -->
            <div class="flex xl:hidden items-center justify-between w-full">
                <span class="text-xs uppercase tracking-wider text-slate-300 font-oswald flex items-center gap-2">
                    <i class="fa-solid fa-graduation-cap text-amber-400"></i> Гімназія №201
                </span>
                <button id="mobile-menu-btn" aria-label="Відкрити меню" class="p-2 rounded-lg bg-white/10 hover:bg-white/20 text-white focus:outline-none transition-colors flex items-center gap-2 text-sm font-semibold">
                    <span>Меню</span>
                    <i id="hamburger-icon" class="fa-solid fa-bars text-lg"></i>
                </button>
            </div>

            <!-- Social Icons (Desktop) -->
            <div class="social-icons hidden xl:flex items-center gap-2 ml-4 flex-shrink-0">
                {socialLinks.map((social) => (
                    <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/30 flex items-center justify-center transition-all text-xs">
                        <i class={social.icon}></i>
                    </a>
                ))}
            </div>
        </div>

        <!-- Mobile Dropdown Navigation Drawer -->
        <div id="mobile-menu" class="hidden xl:hidden bg-slate-900/95 border-t border-white/10 px-4 py-3 space-y-2 backdrop-blur-lg">
            {navLinks.map((link) => (
                <a href={link.href} class="mobile-nav-link block text-slate-100 hover:bg-white/10 hover:text-amber-300 px-3 py-2 rounded-lg text-sm font-medium transition-colors">
                    {link.label}
                </a>
            ))}
            
            <div class="pt-3 mt-2 border-t border-white/10 flex items-center justify-around">
                {socialLinks.map((social) => (
                    <a href={social.href} target="_blank" class="text-slate-300 hover:text-white text-lg" aria-label={social.label}>
                        <i class={social.icon}></i>
                    </a>
                ))}
            </div>
        </div>
    </nav>

    <!-- Main Hero Content -->
    <div id="hero" class="hero-content relative z-10 max-w-7xl mx-auto px-6 py-10 md:py-14 flex flex-col md:flex-row items-center justify-center gap-6 text-center md:text-left">
        <!-- School Logo -->
        <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-amber-400 to-indigo-400 rounded-full blur opacity-30 group-hover:opacity-75 transition duration-500"></div>
            <img src="/logo.jpg" 
                 alt="Логотип Гімназії №201" 
                 class="hero-logo w-32 h-32 sm:w-40 sm:h-40 md:w-48 md:h-48 object-cover rounded-full border-4 border-white/80 shadow-2xl relative bg-white"
                 onerror="this.onerror=null; this.src='https://placehold.co/200x200/4b6496/ffffff?text=Гімназія+201';">
        </div>

        <!-- Title & Subtitle -->
        <div class="space-y-2 max-w-2xl">
            <h1 class="font-oswald text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white drop-shadow-md leading-tight">
                Сайт Гімназії №201
            </h1>
            <p class="text-slate-200 font-light text-base sm:text-lg max-w-xl mx-auto md:mx-0">
                Освітній простір творчості, знань та інновацій для майбутнього України
            </p>
        </div>
    </div>
</header>

<!-- Специфічні CSS-анімації для плаваючих іконок -->
<style>
    .pop-item {
        position: absolute;
        opacity: 0;
        animation: popAndFloat 8s linear infinite;
        user-select: none;
        pointer-events: none;
    }

    @keyframes popAndFloat {
        0% {
            opacity: 0;
            transform: translateY(20px) scale(0.6) rotate(0deg);
        }
        15% {
            opacity: 0.35;
            transform: translateY(-15px) scale(1.1) rotate(10deg);
        }
        50% {
            opacity: 0.25;
            transform: translateY(-50px) scale(1) rotate(-10deg);
        }
        85% {
            opacity: 0.15;
            transform: translateY(-100px) scale(0.9) rotate(15deg);
        }
        100% {
            opacity: 0;
            transform: translateY(-140px) scale(0.7) rotate(30deg);
        }
    }

    .item-1 { left: 8%; bottom: -10px; animation-duration: 7s; animation-delay: 0s; }
    .item-2 { left: 28%; bottom: -10px; animation-duration: 9s; animation-delay: 2.2s; }
    .item-3 { left: 58%; bottom: -10px; animation-duration: 6.5s; animation-delay: 4.1s; }
    .item-4 { left: 78%; bottom: -10px; animation-duration: 8.5s; animation-delay: 1.2s; }
    .item-5 { left: 92%; bottom: -10px; animation-duration: 10s; animation-delay: 5s; }
</style>

<!-- Клієнтський скрипт для мобільного меню в Astro -->
<script>
    function setupMobileMenu() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const icon = document.getElementById('hamburger-icon');
        const navLinks = document.querySelectorAll('.mobile-nav-link');

        if (!menuBtn || !menu || !icon) return;

        function toggleMobileMenu() {
            const isHidden = menu.classList.contains('hidden');
            if (isHidden) {
                menu.classList.remove('hidden');
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-xmark');
            } else {
                menu.classList.add('hidden');
                icon.classList.remove('fa-xmark');
                icon.classList.add('fa-bars');
            }
        }

        menuBtn.addEventListener('click', toggleMobileMenu);

        // Закривати меню при кліку на будь-яке посилання
        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                menu.classList.add('hidden');
                icon.classList.remove('fa-xmark');
                icon.classList.add('fa-bars');
            });
        });
    }

    // Підтримка Astro View Transitions та звичайного завантаження сторінки
    document.addEventListener('astro:page-load', setupMobileMenu);
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
</script>
