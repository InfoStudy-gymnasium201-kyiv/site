---
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import InformationAboutInstitution from '../../components/InformationAboutInstitution/InformationAboutInstitution.astro'
import CategoriesMenu from '../../components/InformationAboutInstitution/CategoriesMenuInfoAboutInst.astro'

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<Header />
	<!DOCTYPE html>
<html lang="uk" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Гімназія №201 Дніпровського району м. Києва</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎓</text></svg>">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Oswald & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f4f8',
                            100: '#d9e2ec',
                            200: '#bcccdc',
                            300: '#9fb3c8',
                            400: '#829ab1',
                            500: '#4b6496', // Primary tone from school branding
                            600: '#394e77',
                            700: '#2c3e50',
                            800: '#1e293b',
                            900: '#0f172a'
                        }
                    },
                    fontFamily: {
                        oswald: ['Oswald', 'sans-serif'],
                        inter: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        .pop-item {
            position: absolute;
            opacity: 0;
            animation: popAndFloat 8s linear infinite;
            user-select: none;
            pointer-events: none;
        }

        @keyframes popAndFloat {
            0% {
                opacity: 0;
                transform: translateY(20px) scale(0.6) rotate(0deg);
            }
            15% {
                opacity: 0.35;
                transform: translateY(-15px) scale(1.1) rotate(10deg);
            }
            50% {
                opacity: 0.25;
                transform: translateY(-50px) scale(1) rotate(-10deg);
            }
            85% {
                opacity: 0.15;
                transform: translateY(-100px) scale(0.9) rotate(15deg);
            }
            100% {
                opacity: 0;
                transform: translateY(-140px) scale(0.7) rotate(30deg);
            }
        }

        .item-1 { left: 8%; bottom: -10px; animation-duration: 7s; animation-delay: 0s; }
        .item-2 { left: 28%; bottom: -10px; animation-duration: 9s; animation-delay: 2.2s; }
        .item-3 { left: 58%; bottom: -10px; animation-duration: 6.5s; animation-delay: 4.1s; }
        .item-4 { left: 78%; bottom: -10px; animation-duration: 8.5s; animation-delay: 1.2s; }
        .item-5 { left: 92%; bottom: -10px; animation-duration: 10s; animation-delay: 5s; }

        .page-title::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 4px;
            background-color: #4b6496;
            border-radius: 9999px;
        }

        .btn-gradient-shadow {
            background-image: linear-gradient(135deg, #4b6496 0%, #2c3e50 100%);
            box-shadow: 0 4px 14px rgba(75, 100, 150, 0.35);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-gradient-shadow:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(75, 100, 150, 0.45);
        }
    </style>
</head>
<body class="font-inter bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col justify-between">

    <header class="relative bg-gradient-to-br from-[#394e77] via-[#4b6496] to-[#2c3e50] text-white overflow-hidden shadow-lg border-b border-indigo-900/20">
        
        <!-- Animated Background Icons -->
        <div class="animated-background absolute inset-0 overflow-hidden pointer-events-none z-0">
            <div class="pop-item item-1 text-4xl text-white/30"><i class="fa-solid fa-graduation-cap"></i></div>
            <div class="pop-item item-2 text-3xl text-white/30"><i class="fa-solid fa-book-open"></i></div>
            <div class="pop-item item-3 text-4xl text-white/30"><i class="fa-solid fa-atom"></i></div>
            <div class="pop-item item-4 text-3xl text-white/30"><i class="fa-solid fa-award"></i></div>
            <div class="pop-item item-5 text-4xl text-white/30"><i class="fa-solid fa-pen-nib"></i></div>
        </div>

        <!-- TOP NAVIGATION BAR -->
        <nav class="relative z-20 bg-slate-900/40 backdrop-blur-md border-b border-white/10">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-auto min-h-[3.5rem] py-2 text-sm font-medium">
                
                <!-- Desktop Navigation Links -->
                <div class="hidden xl:flex items-center space-x-3 2xl:space-x-5 py-1">
                    <a href="#important-news" class="text-white hover:text-amber-300 transition-colors px-2 py-1 rounded-md text-xs 2xl:text-sm font-semibold whitespace-nowrap">Новини</a>
                    <a href="#about-section" class="text-slate-200 hover:text-amber-300 transition-colors px-2 py-1 rounded-md text-xs 2xl:text-sm whitespace-nowrap">Інформація про заклад</a>
                    <a href="#history-section" class="text-slate-200 hover:text-amber-300 transition-colors px-2 py-1 rounded-md text-xs 2xl:text-sm whitespace-nowrap">Історія гімназії</a>
                    <a href="#transparency-section" class="text-slate-200 hover:text-amber-300 transition-colors px-2 py-1 rounded-md text-xs 2xl:text-sm whitespace-nowrap">Прозорість та інформаційна відкритість закладу</a>
                    <a href="#european-space-section" class="text-slate-200 hover:text-amber-300 transition-colors px-2 py-1 rounded-md text-xs 2xl:text-sm whitespace-nowrap">Заклад - частина європейського освітнього простору</a>
                    <a href="#education-process-section" class="text-slate-200 hover:text-amber-300 transition-colors px-2 py-1 rounded-md text-xs 2xl:text-sm whitespace-nowrap">Освітній процес</a>
                </div>

                <!-- Mobile Menu Header Button -->
                <div class="flex xl:hidden items-center justify-between w-full">
                    <span class="text-xs uppercase tracking-wider text-slate-300 font-oswald flex items-center gap-2">
                        <i class="fa-solid fa-graduation-cap text-amber-400"></i> Гімназія №201
                    </span>
                    <button id="mobile-menu-btn" onclick="toggleMobileMenu()" aria-label="Відкрити меню" class="p-2 rounded-lg bg-white/10 hover:bg-white/20 text-white focus:outline-none transition-colors flex items-center gap-2 text-sm font-semibold">
                        <span>Меню</span>
                        <i id="hamburger-icon" class="fa-solid fa-bars text-lg"></i>
                    </button>
                </div>

                <!-- Social & Media Icons -->
                <div class="social-icons hidden xl:flex items-center gap-2 ml-4 flex-shrink-0">
                    <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/30 flex items-center justify-center transition-all text-xs">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="https://t.me" target="_blank" rel="noopener noreferrer" title="Telegram" aria-label="Telegram" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/30 flex items-center justify-center transition-all text-xs">
                        <i class="fa-brands fa-telegram"></i>
                    </a>
                    <a href="mailto:sch201@ukr.net" title="Електронна пошта" aria-label="Email" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/30 flex items-center justify-center transition-all text-xs">
                        <i class="fa-solid fa-envelope"></i>
                    </a>
                </div>
            </div>

            <div id="mobile-menu" class="hidden xl:hidden bg-slate-900/95 border-t border-white/10 px-4 py-3 space-y-2 backdrop-blur-lg">
                <a href="#important-news" onclick="toggleMobileMenu()" class="block text-slate-100 hover:bg-white/10 hover:text-amber-300 px-3 py-2 rounded-lg text-sm font-medium transition-colors">Новини</a>
                <a href="#about-section" onclick="toggleMobileMenu()" class="block text-slate-100 hover:bg-white/10 hover:text-amber-300 px-3 py-2 rounded-lg text-sm font-medium transition-colors">Інформація про заклад</a>
                <a href="#history-section" onclick="toggleMobileMenu()" class="block text-slate-100 hover:bg-white/10 hover:text-amber-300 px-3 py-2 rounded-lg text-sm font-medium transition-colors">Історія гімназії</a>
                <a href="#transparency-section" onclick="toggleMobileMenu()" class="block text-slate-100 hover:bg-white/10 hover:text-amber-300 px-3 py-2 rounded-lg text-sm font-medium transition-colors">Прозорість та інформаційна відкритість закладу</a>
                <a href="#european-space-section" onclick="toggleMobileMenu()" class="block text-slate-100 hover:bg-white/10 hover:text-amber-300 px-3 py-2 rounded-lg text-sm font-medium transition-colors">Заклад - частина європейського освітнього простору</a>
                <a href="#education-process-section" onclick="toggleMobileMenu()" class="block text-slate-100 hover:bg-white/10 hover:text-amber-300 px-3 py-2 rounded-lg text-sm font-medium transition-colors">Освітній процес</a>
                
                <div class="pt-3 mt-2 border-t border-white/10 flex items-center justify-around">
                    <a href="https://facebook.com" target="_blank" class="text-slate-300 hover:text-white text-lg"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="https://t.me" target="_blank" class="text-slate-300 hover:text-white text-lg"><i class="fa-brands fa-telegram"></i></a>
                    <a href="mailto:sch201@ukr.net" class="text-slate-300 hover:text-white text-lg"><i class="fa-solid fa-envelope"></i></a>
                </div>
            </div>
        </nav>

        <!-- Main Hero Header Content -->
        <div id="hero" class="hero-content relative z-10 max-w-7xl mx-auto px-6 py-10 md:py-14 flex flex-col md:flex-row items-center justify-center gap-6 text-center md:text-left">
            <!-- School Emblem -->
            <div class="relative group flex-shrink-0">
                <div class="absolute -inset-1 bg-gradient-to-r from-amber-400 to-indigo-400 rounded-full blur opacity-40 group-hover:opacity-80 transition duration-500"></div>
                <div class="w-32 h-32 sm:w-40 sm:h-40 md:w-44 md:h-44 rounded-full border-4 border-white/90 shadow-2xl relative bg-white flex items-center justify-center p-3">
                    <!-- High Quality School Emblem SVG Vector -->
                    <svg viewBox="0 0 200 200" class="w-full h-full">
                        <circle cx="100" cy="100" r="95" fill="none" stroke="#4b6496" stroke-width="4"/>
                        <circle cx="100" cy="100" r="88" fill="none" stroke="#d9e2ec" stroke-width="1.5" stroke-dasharray="4,3"/>
                        <path d="M 40 120 C 40 150, 160 150, 160 120 C 160 80, 40 80, 40 120" fill="none" stroke="#2c3e50" stroke-width="2.5"/>
                        <!-- Ears of Wheat -->
                        <path d="M 35 130 Q 25 100 45 60" fill="none" stroke="#eab308" stroke-width="3" stroke-linecap="round"/>
                        <path d="M 165 130 Q 175 100 155 60" fill="none" stroke="#eab308" stroke-width="3" stroke-linecap="round"/>
                        <!-- Book -->
                        <path d="M 60 125 Q 100 115 100 135 Q 100 115 140 125 L 140 145 Q 100 135 100 155 Q 100 135 60 145 Z" fill="#4b6496" opacity="0.9"/>
                        <!-- Sprout -->
                        <path d="M 100 120 Q 90 90 70 85 Q 95 90 100 120 Q 105 90 130 85 Q 110 90 100 120 Z" fill="#22c55e"/>
                        <text x="100" y="62" font-family="'Oswald', sans-serif" font-size="34" font-weight="bold" fill="#394e77" text-anchor="middle">201</text>
                    </svg>
                </div>
            </div>

            <!-- Title & Subtitle -->
            <div class="space-y-2 max-w-3xl">
                <h1 class="font-oswald text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white drop-shadow-md leading-tight">
                    Гімназія №201 Дніпровського району м. Києва
                </h1>
                <p class="text-slate-200 font-light text-base sm:text-lg max-w-xl mx-auto md:mx-0">
                    Освітній простір творчості, знань та інновацій для майбутнього України
                </p>
            </div>
        </div>

        <div class="relative z-20 bg-slate-900/60 backdrop-blur-md border-t border-white/10 py-3 px-4">
            <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs sm:text-sm">
                <button onclick="openSubModal('Адміністрація Гімназії №201', 'Інформація про керівництво закладу та години прийому громадян.', 'Адміністрація закладу забезпечує якісне функціонування освітнього процесу, реалізацію освітньої програми та безпеку всіх учасників навчння.<br><br><b>Контактний телефон:</b> +38 (063) 319-79-82<br><b>Електронна пошта:</b> sch201@ukr.net')" class="bg-brand-500/80 hover:bg-brand-500 text-white font-medium px-4 py-2 rounded-xl transition-all shadow-sm hover:shadow flex items-center gap-2">
                    <i class="fa-solid fa-user-tie text-amber-300"></i> Адміністрація
                </button>
                <button onclick="openSubModal('Педагогічний колектив', 'Професійні вчителі та наставники Гімназії №201.', 'Педагогічний колектив гімназії складається з висококваліфікованих фахівців, вчителів вищої категорії, старших вчителів та вчителів-методистів, які впроваджують сучасні методики дитиноцентризму та принципів НУШ.')" class="bg-brand-500/80 hover:bg-brand-500 text-white font-medium px-4 py-2 rounded-xl transition-all shadow-sm hover:shadow flex items-center gap-2">
                    <i class="fa-solid fa-chalkboard-user text-amber-300"></i> Педагогічний колектив
                </button>
                <button onclick="openSubModal('Інноваційна й експериментальна діяльність', 'Статус всеукраїнського експериментального закладу.', 'Школа є експериментальним навчальним закладом всеукраїнського рівня з проблеми:<br><blockquote class=\"p-3 bg-slate-100 border-l-4 border-brand-500 rounded my-2 text-slate-800 italic font-medium\">«Організаційно-педагогічні умови функціонування та розвитку безпечної школи у постпандемічний час»</blockquote>')" class="bg-brand-500/80 hover:bg-brand-500 text-white font-medium px-4 py-2 rounded-xl transition-all shadow-sm hover:shadow flex items-center gap-2">
                    <i class="fa-solid fa-flask text-amber-300"></i> Інноваційна діяльність
                </button>
                <a href="#contacts" class="bg-brand-500/80 hover:bg-brand-500 text-white font-medium px-4 py-2 rounded-xl transition-all shadow-sm hover:shadow flex items-center gap-2">
                    <i class="fa-solid fa-location-dot text-amber-300"></i> Контакти
                </a>
                <button onclick="openSubModal('Організація харчування в закладі', 'Інформація про харчування та дотримання санітарних норм.', 'У закладі забезпечується якісне, збалансоване та безпечне харчування здобувачів освіти відповідно до затверджених норм та санітарних стандартів України.')" class="bg-brand-500/80 hover:bg-brand-500 text-white font-medium px-4 py-2 rounded-xl transition-all shadow-sm hover:shadow flex items-center gap-2">
                    <i class="fa-solid fa-utensils text-amber-300"></i> Організація харчування
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">

        <!-- MAIN SCHOOL TITLE & BUILDING PHOTO SECTION -->
        <section id="about-section" class="bg-white rounded-3xl p-6 sm:p-8 md:p-10 shadow-lg border border-slate-200/80 transition-all">
            <div class="text-center mb-8">
                <h2 class="page-title font-oswald text-2xl sm:text-4xl font-bold text-slate-900 relative pb-4 inline-block tracking-tight">
                    Гімназія №201 Дніпровського району м. Києва
                </h2>
            </div>

            <!-- School Photo Frame -->
            <div class="relative rounded-2xl overflow-hidden shadow-xl mb-8 max-w-4xl mx-auto group">
                <img src="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=1200&q=80" 
                     alt="Будівля Гімназії №201" 
                     class="w-full h-64 sm:h-80 md:h-[400px] object-cover group-hover:scale-105 transition-transform duration-700">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent flex items-end p-6">
                    <p class="text-white font-medium text-sm sm:text-base flex items-center gap-2 drop-shadow">
                        <i class="fa-solid fa-building text-amber-400"></i>
                        Головний корпус гімназії • Дніпровський район, проспект Воскресенський, 14А
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-8">
                
                <!-- About Block -->
                <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 mb-4 text-brand-600">
                            <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center text-xl">
                                <i class="fa-solid fa-school"></i>
                            </div>
                            <h3 class="font-oswald text-xl font-bold text-slate-900">Про заклад</h3>
                        </div>
                        <p class="text-slate-700 leading-relaxed text-sm sm:text-base mb-3">
                            Заклад заснований у <span class="font-bold text-slate-900">1971 році</span>, мова навчання – <span class="font-bold text-slate-900">українська</span>.
                        </p>
                        <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
                            У <span class="font-bold text-slate-900">2026-2027 році</span> в <span class="font-bold text-slate-900">26 класах</span> школи навчаються <span class="font-bold text-slate-900">712 учнів</span>. Школа працює за п'ятиденним робочим тижнем.
                        </p>
                    </div>
                </div>

                <!-- Schedule Block -->
                <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 mb-4 text-brand-600">
                            <div class="w-10 h-10 rounded-xl bg-brand-50 flex items-center justify-center text-xl">
                                <i class="fa-solid fa-clock"></i>
                            </div>
                            <h3 class="font-oswald text-xl font-bold text-slate-900">Розклад</h3>
                        </div>
                        <p class="text-slate-700 leading-relaxed text-sm sm:text-base mb-3">
                            Навчальні заняття розпочинаються <span class="font-bold text-slate-900">о 08.30</span>.
                        </p>
                        <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
                            Освітній процес у закладі здійснюється на засадах <span class="font-bold text-slate-900">дитиноцентризму</span> відповідно до принципів <span class="font-bold text-slate-900">НУШ</span>.
                        </p>
                    </div>
                </div>
            </div>

            <div id="education-process-section" class="bg-gradient-to-br from-brand-50 via-white to-slate-50 rounded-2xl p-6 sm:p-8 border border-brand-100 shadow-sm mb-8">
                <div class="flex items-center gap-3 mb-4 text-brand-600">
                    <div class="w-10 h-10 rounded-xl bg-brand-500 text-white flex items-center justify-center text-xl shadow-md">
                        <i class="fa-solid fa-book-bookmark"></i>
                    </div>
                    <h3 class="font-oswald text-2xl font-bold text-slate-900">Освітні програми</h3>
                </div>

                <p class="text-slate-800 text-base font-semibold mb-3">
                    1-9 класи <span class="font-normal text-slate-700">працюють за програмою <span class="font-semibold text-slate-900">НУШ</span>.</span>
                </p>

                <ul class="space-y-2 text-slate-700 text-sm sm:text-base mb-6 pl-2">
                    <li class="flex items-start gap-2">
                        <i class="fa-solid fa-circle-dot text-brand-500 text-xs mt-1.5"></i>
                        <span>Річний навчальний план на 2026-2027 навчальний рік</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <i class="fa-solid fa-circle-dot text-brand-500 text-xs mt-1.5"></i>
                        <span>освітня програма на 2026-2027 навчальний рік для 1-4 класів</span>
                    </li>
                </ul>

                <!-- Experimental Status Box -->
                <div class="bg-white rounded-xl p-5 border border-brand-200 shadow-sm">
                    <span class="inline-block bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full mb-2 uppercase tracking-wide">
                        Експериментальний статус
                    </span>
                    <p class="text-slate-800 font-semibold text-sm sm:text-base mb-2">
                        Школа – експериментальний навчальний заклад всеукраїнського рівня з проблеми:
                    </p>
                    <blockquote class="italic text-brand-700 font-medium pl-4 border-l-4 border-amber-400 py-1 text-sm sm:text-base bg-amber-50/50 rounded-r-lg">
