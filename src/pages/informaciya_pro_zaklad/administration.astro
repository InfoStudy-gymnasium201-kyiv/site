---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import CategoriesMenu from '../../components/InformationAboutInstitution/CategoriesMenuInfoAboutInst.astro'
---

<Layout>
    <header />
    <CategoriesMenu />
    <div class="flex-grow max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 font-inter">
    <!-- Заголовок сторінки у стилі нового дизайну -->
    <div class="page-title-container text-center mb-12">
        <h1 class="page-title font-oswald text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-800 relative pb-4 inline-block tracking-wide">
            Адміністрація гімназії №201
        </h1>
    </div>

    <article class="space-y-8">
        <!-- Директор гімназії (головний картка-акцент) -->
        <div class="bg-gradient-to-br from-brand-50/80 via-white to-slate-50 p-6 sm:p-8 rounded-2xl shadow-md border border-brand-100/60 transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5">
            <span class="inline-block bg-brand-500 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-3">
                Керівництво закладу
            </span>
            
            <h2 class="text-xl sm:text-2xl font-bold text-slate-700 text-center mb-1">
                Директор гімназії
            </h2>

            <h3 class="font-oswald text-3xl sm:text-4xl font-bold text-brand-600 text-center mb-6 tracking-wide">
                Гмиря Ганна Володимирівна
            </h3>

            <div class="flex justify-center mb-6">
                <div class="relative group max-w-xs sm:max-w-sm">
                    <div class="absolute -inset-1 bg-gradient-to-r from-brand-500 to-indigo-400 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-300"></div>
                    <img 
                        alt="Гмиря А.В. директор.JPG" 
                        src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(1).JPG?raw=true" 
                        class="relative w-full h-auto object-cover rounded-xl shadow-md border border-white"
                    />
                </div>
            </div>

            <h4 class="text-base sm:text-lg font-medium text-slate-600 text-center max-w-2xl mx-auto leading-relaxed">
                Учитель зарубіжної літератури, спеціаліст вищої категорії, учитель-методист, "Відмінник освіти України"
            </h4>
        </div>

        <!-- Розділювальна лінія між директором та заступниками -->
        <div class="relative py-2">
            <div class="absolute inset-0 flex items-center" aria-hidden="true">
                <div class="w-full border-t border-slate-200"></div>
            </div>
            <div class="relative flex justify-center">
                <span class="bg-slate-100 px-4 text-xs font-semibold text-slate-400 uppercase tracking-widest">
                    Заступники директора
                </span>
            </div>
        </div>

        <!-- Заступник 1 -->
        <div class="bg-white p-6 sm:p-7 rounded-2xl shadow-sm border border-slate-200/80 transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
            <h2 class="text-lg sm:text-xl font-bold text-slate-700 text-center mb-1">
                Заступник директора з навчально-виховної роботи
            </h2>

            <h3 class="font-oswald text-2xl sm:text-3xl font-bold text-brand-600 text-center mb-5 tracking-wide">
                Мефодьєва Світлана Олександрівна
            </h3>

            <div class="flex justify-center mb-5">
                <img 
                    alt="Мефодьєва С.О.заст.дир..JPG" 
                    src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(2).JPG?raw=true" 
                    class="w-64 sm:w-72 h-auto object-cover rounded-xl shadow-md border border-slate-100"
                />
            </div>

            <h4 class="text-sm sm:text-base font-medium text-slate-600 text-center max-w-xl mx-auto leading-relaxed">
                Учитель української мови і літератури, спеціаліст вищої категорії, "Вчитель-методист, "Відмінник освіти України"
            </h4>
        </div>

        <!-- Заступник 2 -->
        <div class="bg-white p-6 sm:p-7 rounded-2xl shadow-sm border border-slate-200/80 transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
            <h2 class="text-lg sm:text-xl font-bold text-slate-700 text-center mb-1">
                Заступник директора з навчально-виховної роботи
            </h2>

            <h3 class="font-oswald text-2xl sm:text-3xl font-bold text-brand-600 text-center mb-5 tracking-wide">
                Лобанова Юлія Юріївна
            </h3>

            <div class="flex justify-center mb-5">
                <img 
                    alt="Лобанова Ю.Ю.вч.осн.здор..JPG" 
                    src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(3).JPG?raw=true" 
                    class="w-64 sm:w-72 h-auto object-cover rounded-xl shadow-md border border-slate-100"
                />
            </div>

            <h4 class="text-sm sm:text-base font-medium text-slate-600 text-center max-w-xl mx-auto leading-relaxed">
                Учитель фізики та астрономії, спеціаліст вищої категорії, "Вчитель-методист"
            </h4>
        </div>

        <!-- Заступник 3 -->
        <div class="bg-white p-6 sm:p-7 rounded-2xl shadow-sm border border-slate-200/80 transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
            <h2 class="text-lg sm:text-xl font-bold text-slate-700 text-center mb-1">
                Заступник директора з навчально-виховної роботи
            </h2>

            <h3 class="font-oswald text-2xl sm:text-3xl font-bold text-brand-600 text-center mb-5 tracking-wide">
                Лейко Інна Вікторівна
            </h3>

            <div class="flex justify-center mb-5">
                <img 
                    alt="зображення_viber_2023-12-13_17-18-07-800.jpg" 
                    src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(4).jpg?raw=true" 
                    class="w-64 sm:w-72 h-auto object-cover rounded-xl shadow-md border border-slate-100"
                />
            </div>

            <h4 class="text-sm sm:text-base font-medium text-slate-600 text-center max-w-xl mx-auto leading-relaxed">
                Учитель хімії, спеціаліст вищої категорії, "Вчитель-методист"
            </h4>
        </div>

        <!-- Заступник 4 (АГЧ) -->
        <div class="bg-white p-6 sm:p-7 rounded-2xl shadow-sm border border-slate-200/80 transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
            <h2 class="text-lg sm:text-xl font-bold text-slate-700 text-center mb-1">
                Заступник директора з адміністративно-господарської частини
            </h2>

            <h3 class="font-oswald text-2xl sm:text-3xl font-bold text-brand-600 text-center mb-5 tracking-wide">
                Мельник Наталія Павлівна
            </h3>

            <div class="flex justify-center">
                <img 
                    alt="зображення_viber_2024-02-02_14-06-32-299.jpg" 
                    src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(5).jpg?raw=true" 
                    class="w-64 sm:w-72 h-auto object-cover rounded-xl shadow-md border border-slate-100"
                />
            </div>
        </div>
    </article>
</div>

<style>
    /* Декоративна лінія для заголовка сторінки відповідно до стилю сайту */
    .page-title::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 4px;
        background-color: #4b6496;
        border-radius: 9999px;
    }
</style>
    <footer />
</Layout>
