---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import CategoriesMenu from '../../components/InformationAboutInstitution/CategoriesMenuInfoAboutInst.astro'
---

<Layout>
    <header />
    <CategoriesMenu />
    <section class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 font-inter">
    <!-- Заголовок сторінки -->
    <div class="text-center mb-12">
        <h1 class="font-oswald text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-800 relative pb-4 inline-block tracking-wide page-title">
            Адміністрація гімназії №201
        </h1>
        <p class="text-slate-500 text-sm sm:text-base mt-2">
            Керівний склад нашого освітнього закладу
        </p>
    </div>

    <!-- КАРТКА ДИРЕКТОРА (Акцентна/Головна) -->
    <div class="mb-12 bg-gradient-to-br from-brand-50 via-white to-slate-50 border-l-4 border-brand-500 rounded-2xl p-6 sm:p-8 shadow-md border border-slate-200 transition duration-300 hover:shadow-xl">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-6 lg:gap-8">
            <!-- Фото директора -->
            <div class="flex-shrink-0 relative group">
                <div class="absolute -inset-1 bg-gradient-to-r from-amber-400 to-brand-500 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-300"></div>
                <img 
                    src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(1).JPG?raw=true" 
                    alt="Гмиря Ганна Володимирівна — Директор" 
                    class="relative w-48 h-60 sm:w-56 sm:h-72 object-cover rounded-2xl shadow-lg border-2 border-white"
                />
            </div>

            <!-- Інформація про директора -->
            <div class="flex-grow text-center md:text-left space-y-3">
                <span class="inline-block bg-brand-500 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                    Директор гімназії
                </span>
                <h2 class="font-oswald text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-700 leading-tight">
                    Гмиря Ганна Володимирівна
                </h2>
                <div class="pt-2">
                    <p class="text-slate-700 font-medium text-sm sm:text-base lg:text-lg leading-relaxed">
                        Учитель зарубіжної літератури, спеціаліст вищої категорії, учитель-методист, <span class="text-amber-600 font-semibold">«Відмінник освіти України»</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- СІТКА ЗАСТУПНИКІВ (2 в ряд на середніх і великих екранах) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        
        <!-- Заступник 1 -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-100 flex flex-col items-center text-center transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
            <div class="relative mb-4 overflow-hidden rounded-2xl shadow-md w-44 h-56 sm:w-48 sm:h-60">
                <img 
                    src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(2).JPG?raw=true" 
                    alt="Мефодьєва Світлана Олександрівна" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
            </div>
            <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full mb-2">
                Заступник директора з НВР
            </span>
            <h3 class="font-oswald text-xl sm:text-2xl font-bold text-slate-800 mb-2 group-hover:text-brand-600 transition-colors">
                Мефодьєва Світлана Олександрівна
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mt-auto">
                Учитель української мови і літератури, спеціаліст вищої категорії, «Учитель-методист», «Відмінник освіти України»
            </p>
        </div>

        <!-- Заступник 2 -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-100 flex flex-col items-center text-center transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
            <div class="relative mb-4 overflow-hidden rounded-2xl shadow-md w-44 h-56 sm:w-48 sm:h-60">
                <img 
                    src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(3).JPG?raw=true" 
                    alt="Лобанова Юлія Юріївна" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
            </div>
            <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full mb-2">
                Заступник директора з НВР
            </span>
            <h3 class="font-oswald text-xl sm:text-2xl font-bold text-slate-800 mb-2 group-hover:text-brand-600 transition-colors">
                Лобанова Юлія Юріївна
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mt-auto">
                Учитель фізики та астрономії, спеціаліст вищої категорії, «Учитель-методист»
            </p>
        </div>

        <!-- Заступник 3 -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-100 flex flex-col items-center text-center transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
            <div class="relative mb-4 overflow-hidden rounded-2xl shadow-md w-44 h-56 sm:w-48 sm:h-60">
                <img 
                    src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(4).jpg?raw=true" 
                    alt="Лейко Інна Вікторівна" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
            </div>
            <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full mb-2">
                Заступник директора з НВР
            </span>
            <h3 class="font-oswald text-xl sm:text-2xl font-bold text-slate-800 mb-2 group-hover:text-brand-600 transition-colors">
                Лейко Інна Вікторівна
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mt-auto">
                Учитель хімії, спеціаліст вищої категорії, «Учитель-методист»
            </p>
        </div>

        <!-- Заступник 4 (АГЧ) -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-100 flex flex-col items-center text-center transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
            <div class="relative mb-4 overflow-hidden rounded-2xl shadow-md w-44 h-56 sm:w-48 sm:h-60">
                <img 
                    src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(5).jpg?raw=true" 
                    alt="Мельник Наталія Павлівна" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
            </div>
            <span class="text-xs font-semibold text-amber-700 bg-amber-50 px-3 py-1 rounded-full mb-2">
                Заступник директора з АГЧ
            </span>
            <h3 class="font-oswald text-xl sm:text-2xl font-bold text-slate-800 mb-2 group-hover:text-brand-600 transition-colors">
                Мельник Наталія Павлівна
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mt-auto">
                Заступник директора з адміністративно-господарської частини
            </p>
        </div>

    </div>
</section>

<style>
    /* Декоративна лінія для заголовка відповідно до макету 201 (1).html */
    .page-title::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 4px;
        background-color: #4b6496;
        border-radius: 9999px;
    }
</style>
    <footer />
</Layout>
