<script>
  function renderSidebar() {
    const navContainer = document.getElementById("auto-sidebar");
    if (!navContainer) return;

    navContainer.innerHTML = "";
    const sections = document.querySelectorAll("main section[id]");

    sections.forEach((section, index) => {
      const heading = section.querySelector("h2");
      if (!heading) return;

      const link = document.createElement("a");
      link.href = `#${section.id}`;
      link.className = "flex items-center text-slate-600 hover:text-brand-700 hover:bg-brand-50 px-3 py-2 rounded-lg font-medium transition";

      const numSpan = document.createElement("span");
      numSpan.className = "w-6 text-brand-600 font-bold flex-shrink-0";
      numSpan.textContent = `${index + 1}.`;

      const textNode = document.createTextNode(heading.textContent.trim());

      link.appendChild(numSpan);
      link.appendChild(textNode);
      navContainer.appendChild(link);
    });
  }

  // Handle initial page load and Astro view transitions
  document.addEventListener("DOMContentLoaded", renderSidebar);
  document.addEventListener("astro:page-load", renderSidebar);
</script>
